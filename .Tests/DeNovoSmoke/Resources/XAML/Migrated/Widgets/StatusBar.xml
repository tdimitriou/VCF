<Border Style="{StaticResource ListWrapper}" CornerRadius="0" BorderColor="&H666666" Height="25">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>
		<TextBlock Grid.Column="0" HorizontalAlignment="1" Text="POS-" ForeColor="&H000000" FontName="Segoe UI" FontSize="9" FontBold="1" ScaleFont="0" Width="100" Height="25" Margin="0,0,0,0"/>
		<TextBlock Grid.Column="1" HorizontalAlignment="0" Text="{Binding TerminalID, Source={StaticResource ResourceKey=AppProperties}, StringFormat=00}" ForeColor="&H000000" FontName="Segoe UI" FontSize="9" FontBold="1" ScaleFont="0" Width="50" Height="25" Margin="0,0,0,0"/>
		<TextBlock Grid.Column="2" HorizontalAlignment="2" Text="|" ForeColor="&H808080" FontName="Segoe UI" FontSize="9" FontBold="1" ScaleFont="0" Width="30" Height="25" Margin="0,0,0,0"/>
		<TextBlock Grid.Column="3" HorizontalAlignment="2" Text="{Binding CurrentUser, Source={StaticResource ResourceKey=AppProperties}}" ForeColor="&H000000" FontName="Segoe UI" FontSize="9" FontBold="1" ScaleFont="0" Height="25" Margin="0,0,0,0"/>
		<TextBlock Grid.Column="4" HorizontalAlignment="2" Text="|" ForeColor="&H808080" FontName="Segoe UI" FontSize="9" FontBold="1" ScaleFont="0" Width="30" Height="25" Margin="0,0,0,0"/>
		<TextBlock Grid.Column="5" HorizontalAlignment="2" Width="180" Height="25" Margin="0,0,0,0" Text="{Binding CurrentTime, Source={StaticResource ResourceKey=AppProperties}, StringFormat=dd/MM/yyyy HH:mm:ss}" ForeColor="&H000000" FontName="Segoe UI" FontSize="9" FontBold="1" ScaleFont="0"/>
	</Grid>
</Border>
