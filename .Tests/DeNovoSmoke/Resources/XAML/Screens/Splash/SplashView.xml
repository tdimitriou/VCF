<UserControl x:Class="SplashView" DataContext="SplashViewModel" Width="1024" Height="768" Alpha="1" Margin="0,0,0,0">
	<TextBlock HorizontalAlignment="2" VerticalAlignment="1" ForeColor="&HFFFFFF" Text="{Binding Text[Loading], Source={StaticResource ResourceKey=LanguageManager}, Converter=CaseConverter, ConverterParameter=Title}" FontName="Segoe UI" FontSize="30" FontBold="1" ScaleFont="0" Alpha="1" Margin="400,359,0,0" Width="224" Height="50"/>
	<TextBlock HorizontalAlignment="2" VerticalAlignment="1" ForeColor="&H00FF00" Text="{Binding Progress}" FontName="Segoe UI" FontSize="30" FontBold="1" ScaleFont="0" Alpha="1" Margin="400,400,0,0" Width="224" Height="50"/>
	<TextBlock HorizontalAlignment="0" VerticalAlignment="1" ForeColor="&HFFFFFF" Text="{Binding InfoMessage}" FontName="Segoe UI" FontSize="12" FontBold="0" ScaleFont="0" Alpha="1" Margin="8,710,0,0" Width="324" Height="50"/>
</UserControl>
