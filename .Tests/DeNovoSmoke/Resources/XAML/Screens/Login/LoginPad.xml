	<Button Style="{StaticResource ButtonCancel}" Command="{Binding ClearInput}">
		<TextBlock Style="{StaticResource ButtonText12B}" Text="{Binding Text[Clear], Source={StaticResource ResourceKey=LanguageManager}, Converter=CaseConverter, ConverterParameter=Title}"/>
	</Button>
	<Button Command="{Binding KeyClick, Source={StaticResource ResourceKey=AppCommands}}" CommandParameter="0">
		<TextBlock Style="{StaticResource ButtonText16}" Text="0"/>
	</Button>
	<Button Style="{StaticResource ButtonSubmit}" Command="{Binding LoginCommand}">
		<TextBlock Style="{StaticResource ButtonText12B}" Text="{Binding Text[Login], Source={StaticResource ResourceKey=LanguageManager}, Converter=CaseConverter, ConverterParameter=Title}"/>
	</Button>
</UniformGrid>
