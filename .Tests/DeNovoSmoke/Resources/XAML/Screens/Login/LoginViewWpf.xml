<UserControl x:Class="LoginView" DataContext="LoginViewModel" Width="1024" Height="768" Alpha="1" Margin="0,0,0,0">

	<Border CornerRadius="0" BorderColor="-1" BackColor="&HB1A200" Alpha="0" Margin="38,29,0,0" Width="283" Height="56">
		<TextBlock HorizontalAlignment="0" VerticalAlignment="0" Padding="0" Text="D e N o v o" ForeColor="&HB1A200" FontSize="20" FontBold="1" ScaleFont="0" Margin="5,0,0,0" Width="273" Height="34"/>
		<TextBlock HorizontalAlignment="0" VerticalAlignment="2" Padding="0" Text="Retail Point Of Sales" ForeColor="&HFFFFFF" FontSize="16" FontBold="0" ScaleFont="0" Margin="5,28,0,0" Width="273" Height="34"/>
	</Border>

	<Border Style="{StaticResource InnerBorder}" Margin="225,200,0,0" Width="574" Height="358">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="204"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Border Grid.Column="0" Style="{StaticResource ListWrapper}" Margin="16,16,8,16">
				<ListView Name="MyList" RowHeight="50" FontSize="14" FontBold="1" BorderColor="-1" Margin="4"/>
			</Border>
			<Grid Grid.Column="1" Margin="8,16,16,16">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>
				<TextBox Grid.Row="0" Style="{StaticResource PasswordBox}" Name="Pwd" CueBanner="PASSWORD / PIN / SWIPE CARD" Text="{Binding PasswordText}" Height="40" Margin="0,0,0,8"/>
				<UniformGrid Grid.Row="1" Columns="1" Rows="1" Padding="0" ShowGridLines="0">
					<res:Screens\Login\LoginPad/>
				</UniformGrid>
			</Grid>
		</Grid>
	</Border>

	<Button Command="{Binding ClockInOutCommand, Source={StaticResource ResourceKey=AppCommands}}" Enabled="False" Margin="816,8,0,0" Width="200" Height="72">
		<Image ImageKey="Resources\ClockIn.png" Margin="4,4,0,0" Width="64" Height="64"/>
		<TextBlock Style="{StaticResource ButtonText12}" Text="Clock In/Out" Margin="68,4,0,0" Width="132" Height="64"/>
	</Button>

	<Button Style="{StaticResource ButtonSubmit}" Command="{Binding RestartCommand, Source={StaticResource ResourceKey=AppCommands}}" Margin="816,566,0,0" Width="200" Height="72">
		<Image ImageKey="Resources\Reboot.png" Margin="4,4,0,0" Width="64" Height="64"/>
		<TextBlock Style="{StaticResource ButtonText12}" Text="{Binding Text[Restart], Source={StaticResource ResourceKey=LanguageManager}, Converter=CaseConverter, ConverterParameter=Title}" Margin="68,4,0,0" Width="132" Height="64"/>
	</Button>

	<Button Style="{StaticResource ButtonCancel}" Command="{Binding ShutdownCommand, Source={StaticResource ResourceKey=AppCommands}}" Margin="816,654,0,0" Width="200" Height="72">
		<Image ImageKey="Resources\Close.png" Margin="4,4,0,0" Width="64" Height="64"/>
		<TextBlock Style="{StaticResource ButtonText12}" Text="{Binding Text[Exit], Source={StaticResource ResourceKey=LanguageManager}, Converter=CaseConverter, ConverterParameter=Title}" Margin="68,4,0,0" Width="132" Height="64"/>
	</Button>

	<res:Widgets\StatusBar Margin="0,743,0,0" Width="1024" Height="25"/>

</UserControl>
