<UserControl x:Class="MainMenuView" DataContext="MainMenuViewModel" Width="1024" Height="768" Alpha="1" Margin="0,0,0,0">

	<Border CornerRadius="0" BorderColor="-1" BackColor="&HB1A200" Alpha="0" Margin="38,29,0,0" Width="400" Height="56">
		<TextBlock Name="MenuTitle" HorizontalAlignment="0" VerticalAlignment="0" Padding="0" Text="{Binding Title}" ForeColor="&HB1A200" FontSize="20" FontBold="1" ScaleFont="0" Margin="5,0,0,0" Width="390" Height="34"/>
		<TextBlock HorizontalAlignment="0" VerticalAlignment="2" Padding="0" Text="{Binding Subtitle}" ForeColor="&HFFFFFF" FontSize="16" FontBold="0" ScaleFont="0" Margin="5,28,0,0" Width="390" Height="34"/>
	</Border>

	<Border Style="{StaticResource InnerBorder}" Margin="225,180,0,0" Width="574" Height="280">
		<TextBlock Name="WelcomeText" HorizontalAlignment="0" Text="{Binding WelcomeMessage}" ForeColor="&HFFFFFF" FontSize="18" FontBold="1" ScaleFont="0" Margin="24,24,0,0" Width="520" Height="40"/>
		<TextBlock Text="{Binding CurrentUser, Source={StaticResource ResourceKey=AppProperties}}" ForeColor="&HFFFFFF" FontSize="14" FontBold="0" ScaleFont="0" Margin="24,80,0,0" Width="520" Height="40"/>

		<Button Name="BtnSales" Style="{StaticResource ButtonSubmit}" Command="{Binding SalesCommand}" Margin="24,160,0,0" Width="200" Height="72">
			<TextBlock Style="{StaticResource ButtonText12}" Text="Sales" Margin="0,0,0,0" Width="200" Height="72"/>
		</Button>
		<Button Name="BtnLogout" Style="{StaticResource ButtonCancel}" Command="{Binding LogoutCommand}" Margin="248,160,0,0" Width="200" Height="72">
			<TextBlock Style="{StaticResource ButtonText12}" Text="Logout" Margin="0,0,0,0" Width="200" Height="72"/>
		</Button>
	</Border>

	<Button Style="{StaticResource ButtonCancel}" Command="{Binding ShutdownCommand, Source={StaticResource ResourceKey=AppCommands}}" Margin="816,654,0,0" Width="200" Height="72">
		<Image ImageKey="Resources\Close.png" Margin="4,4,0,0" Width="64" Height="64"/>
		<TextBlock Style="{StaticResource ButtonText12}" Text="{Binding Text[Exit], Source={StaticResource ResourceKey=LanguageManager}, Converter=CaseConverter, ConverterParameter=Title}" Margin="68,4,0,0" Width="132" Height="64"/>
	</Button>

	<res:Widgets\StatusBar Margin="0,743,0,0" Width="1024" Height="25"/>

</UserControl>
